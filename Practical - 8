#include <iostream>
#include <vector>
#include <queue>
using namespace std;

// ---------- DFS ----------
void DFS(int node, vector<vector<int>>& graph,
         vector<bool>& visited) {

    visited[node] = true;
    cout << node << " ";

    for (int next : graph[node]) {
        if (!visited[next]) {
            DFS(next, graph, visited);
        }
    }
}

// ---------- BFS ----------
void BFS(int start, vector<vector<int>>& graph) {

    vector<bool> visited(graph.size(), false);
    queue<int> q;

    visited[start] = true;
    q.push(start);

    while (!q.empty()) {

        int node = q.front();
        q.pop();

        cout << node << " ";

        for (int next : graph[node]) {
            if (!visited[next]) {
                visited[next] = true;
                q.push(next);
            }
        }
    }
}

int main() {

    int n = 5;

    vector<vector<int>> graph(n);

    // Graph edges
    graph[0] = {1, 2};
    graph[1] = {0, 3, 4};
    graph[2] = {0};
    graph[3] = {1};
    graph[4] = {1};

    vector<bool> visited(n, false);

    cout << "DFS: ";
    DFS(0, graph, visited);

    cout << endl;

    cout << "BFS: ";
    BFS(0, graph);

    return 0;
}
OUTPUT:

DFS: 0 1 3 4 2
BFS: 0 1 2 3 4
