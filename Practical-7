#include <iostream>
#include <vector>
#include <climits>
#include <algorithm>
using namespace std;

int minCoins(vector<int>& coins, int amount) {

    // dp[i] = minimum coins required to make amount i
    vector<int> dp(amount + 1, INT_MAX);

    // 0 coins are needed to make amount 0
    dp[0] = 0;

    for (int i = 1; i <= amount; i++) {

        for (int coin : coins) {

            if (coin <= i && dp[i - coin] != INT_MAX) {
                dp[i] = min(dp[i],
                            1 + dp[i - coin]);
            }
        }
    }

    return dp[amount];
}

int main() {

    vector<int> coins = {1, 2, 5};
    int amount = 11;

    int answer = minCoins(coins, amount);

    cout << "Minimum number of coins = "
         << answer << endl;

    return 0;
}

